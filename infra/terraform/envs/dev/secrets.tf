# Database password, generated by Terraform and stored in AWS Secrets Manager.
# External Secrets copies it into the cluster; it never appears in Git.
# Note: the value is also stored (encrypted) in the Terraform state bucket.
resource "random_password" "db" {
  length  = 24
  special = false
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "shop/db"
  recovery_window_in_days = 0 # delete immediately on destroy, so you can recreate it the same day
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id     = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({ password = random_password.db.result })
}

# ---- EKS Pod Identity: External Secrets may read this one secret, nothing else ----
data "aws_iam_policy_document" "pod_identity_trust" {
  statement {
    actions = ["sts:AssumeRole", "sts:TagSession"]
    principals {
      type        = "Service"
      identifiers = ["pods.eks.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "external_secrets" {
  name               = "${var.cluster_name}-external-secrets"
  assume_role_policy = data.aws_iam_policy_document.pod_identity_trust.json
}

data "aws_iam_policy_document" "read_db_secret" {
  statement {
    actions   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
    resources = [aws_secretsmanager_secret.db.arn]
  }
}

resource "aws_iam_role_policy" "external_secrets" {
  name   = "read-shop-db-secret"
  role   = aws_iam_role.external_secrets.id
  policy = data.aws_iam_policy_document.read_db_secret.json
}

resource "aws_eks_pod_identity_association" "external_secrets" {
  cluster_name    = module.eks.cluster_name
  namespace       = "external-secrets"
  service_account = "external-secrets" # the service account the Helm chart creates
  role_arn        = aws_iam_role.external_secrets.arn
}
